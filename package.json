    "format:check": "prettier --check .",
    "snapshot:product": "node scripts/snapshot-product.mjs"
  },
  "dependencies": {
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "sharp": "0.35.4",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
