[Unit]
Description=Synchronize verified PaperEnjoyer release downloads
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=paper-sync
Group=www-data
ExecStart=/usr/bin/python3 /usr/local/lib/paperenjoyer/sync-releases.py
TimeoutStartSec=2h
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/paperenjoyer/mirror

