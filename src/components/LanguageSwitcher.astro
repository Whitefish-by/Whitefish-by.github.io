---
import Icon from './Icon.astro';
import { copy } from '../data/copy';
import {
  locales,
  localeKeys,
  localizedPath,
  type Locale,
  type TranslatedPage,
} from '../data/locales';
interface Props {
  locale: Locale;
  page: TranslatedPage;
}
const { locale, page } = Astro.props;
---

<details class="language-switcher" data-language-switcher>
  <summary aria-label={copy[locale].language}>
    <Icon name="globe" size={16} />
    <span>{locales[locale].name}</span>
    <Icon name="chevron" size={12} />
  </summary>
  <nav class="language-options" aria-label={copy[locale].language}>
    {localeKeys.map((key) => (
      <a
        href={localizedPath(key, page)}
        lang={key}
        hreflang={key}
        aria-current={key === locale ? 'true' : undefined}
        data-language
      >
        {locales[key].name}
        <span aria-hidden="true">{key === locale ? '✓' : ''}</span>
      </a>
    ))}
  </nav>
</details>
<style>
  .language-switcher {
    position: relative;
    flex-shrink: 0;
    font-size: 13px;
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 6px;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--green-dark);
    outline-offset: 3px;
    border-radius: 6px;
  }
  .language-options {
    position: absolute;
    z-index: 100;
    right: 0;
    top: calc(100% + 8px);
    width: 190px;
    max-width: calc(100vw - 32px);
    max-height: min(410px, calc(100dvh - 110px));
    overflow-y: auto;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper, #f8faf7);
    box-shadow: 0 12px 35px #173d2e1a;
  }
  .language-options a {
    min-height: 44px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-radius: 8px;
  }
  .language-options a:hover,
  .language-options a[aria-current] {
    background: #e7efe8;
    color: var(--green-dark);
  }
  @media (max-width: 620px) {
    summary {
      font-size: 12px;
      gap: 5px;
    }
  }
</style>
<script>
  for (const picker of document.querySelectorAll<HTMLDetailsElement>('[data-language-switcher]')) {
    const summary = picker.querySelector('summary')!;
    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && picker.open) {
        picker.open = false;
        summary.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !picker.contains(event.target)) picker.open = false;
    });
    const links = picker.querySelectorAll<HTMLAnchorElement>('[data-language]');
    const updateLinks = () =>
      links.forEach((link) => {
        link.hash = location.hash;
        link.search = location.search;
      });
    updateLinks();
    window.addEventListener('hashchange', updateLinks);
    picker.addEventListener('toggle', updateLinks);
    links.forEach((link) => link.addEventListener('click', updateLinks));
  }
</script>
