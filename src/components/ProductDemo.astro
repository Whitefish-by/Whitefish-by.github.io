---
import Icon from './Icon.astro';
import type { Locale } from '../data/copy';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const zh = locale === 'zh';
---

<div class="interactive-product" data-product-demo>
  <div class="window-toolbar">
    <span class="window-dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="window-title" aria-hidden="true">
      PaperEnjoyer <span class="window-separator">/</span> YOUR RESEARCH, TOGETHER
    </span>
    <div class="demo-window-actions">
      <button
        type="button"
        data-demo-reset
        aria-label={zh ? '重置 / 重试' : 'Reset / retry'}
        title={zh ? '重置 / 重试' : 'Reset / retry'}
      >
        <Icon name="reset" size={14} />
      </button>
      <a
        data-demo-open
        href="/demo/index.html"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={zh ? '独立打开' : 'Open in a new tab'}
        title={zh ? '独立打开' : 'Open in a new tab'}
      >
        <Icon name="expand" size={14} />
      </a>
    </div>
  </div>
  <div class="demo-viewport">
    <img
      class="demo-poster"
      src="/demo/poster.webp"
      width="1680"
      height="1011"
      alt={
        zh
          ? 'Attention Is All You Need：原文 PDF、段落精读与 Self-Attention 问答'
          : 'Attention Is All You Need: PDF, close reading notes and a Self-Attention conversation'
      }
      fetchpriority="high"
    />
    <iframe
      class="demo-frame"
      data-demo-frame
      src="/demo/app/index.html"
      width="1680"
      height="1011"
      loading="lazy"
      title="PaperEnjoyer"
      sandbox="allow-scripts allow-same-origin"
    ></iframe>
  </div>
  <noscript>
    <style>
      .demo-frame,
      [data-demo-reset] {
        display: none;
      }
    </style>
  </noscript>
</div>

<script>
  for (const host of document.querySelectorAll<HTMLElement>('[data-product-demo]')) {
    const viewport = host.querySelector<HTMLElement>('.demo-viewport')!;
    const frame = host.querySelector<HTMLIFrameElement>('[data-demo-frame]')!;
    let timer: ReturnType<typeof setTimeout>;
    const resize = () => {
      frame.style.transform = 'scale(' + viewport.clientWidth / 1680 + ')';
    };
    const failed = () => {
      clearTimeout(timer);
      delete host.dataset.ready;
      host.dataset.error = 'true';
    };
    new ResizeObserver(resize).observe(viewport);
    resize();
    frame.addEventListener('load', () => {
      clearTimeout(timer);
      if (host.dataset.ready !== 'true') timer = setTimeout(failed, 30000);
    });
    window.addEventListener('message', (event) => {
      if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
      if (event.data?.type === 'paperenjoyer-demo:ready') {
        clearTimeout(timer);
        delete host.dataset.error;
        host.dataset.ready = 'true';
      } else if (event.data?.type === 'paperenjoyer-demo:error') {
        failed();
      }
    });
    host.querySelector('[data-demo-reset]')!.addEventListener('click', () => {
      clearTimeout(timer);
      delete host.dataset.ready;
      delete host.dataset.error;
      frame.src = '/demo/app/index.html';
    });
  }
</script>

<style>
  .interactive-product {
    background: #fff;
  }
  .window-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 8px;
    padding-right: 6px;
    min-height: 31px;
  }
  .window-toolbar > .window-title {
    margin-left: 0;
  }
  .demo-window-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 2px;
  }
  .demo-window-actions button,
  .demo-window-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .demo-window-actions button:hover,
  .demo-window-actions a:hover {
    color: #244e3e;
    background: #e8efea;
  }
  .demo-window-actions button:focus-visible,
  .demo-window-actions a:focus-visible {
    outline: 2px solid #547468;
    outline-offset: -2px;
  }
  .demo-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 1680 / 1011;
    overflow: hidden;
  }
  .demo-poster {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
  .demo-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 1680px;
    height: 1011px;
    border: 0;
    transform-origin: top left;
    opacity: 0;
    pointer-events: none;
  }
  [data-ready='true'] .demo-frame {
    opacity: 1;
    pointer-events: auto;
  }
  [data-ready='true'] .demo-poster {
    visibility: hidden;
  }
</style>
