---
import { policyLinks } from '../data/policies';
import { copy, type Locale } from '../data/copy';
import { localizedPath } from '../data/locales';
interface Props {
  locale?: Locale;
  current?: string;
}
const { locale = 'en', current } = Astro.props;
const t = copy[locale];
---

<nav class="policy-links" aria-label={t.policyNavigation}>
  {policyLinks.map((link) => {
    const href = link.key === 'pricing' ? localizedPath(locale, 'pricing') : link.href;
    return (
      <a
        href={href}
        hreflang={link.key === 'pricing' ? locale : 'en'}
        aria-current={current === href ? 'page' : undefined}
      >
        {t[link.key]}
        {locale !== 'en' && link.key !== 'pricing' ? ` (${t.policyEnglish})` : ''}
      </a>
    );
  })}
</nav>
<style>
  .policy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    padding-block: 20px;
    font-size: 13px;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
  }
  a:hover,
  a[aria-current] {
    color: var(--green-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 620px) {
    .policy-links {
      gap: 2px 22px;
    }
  }
</style>
