---
import { policyLinks } from '../data/policies';
import type { Locale } from '../data/copy';
interface Props {
  locale?: Locale;
  current?: string;
}
const { locale = 'en', current } = Astro.props;
---

<nav
  class="policy-links"
  aria-label={locale === 'zh' ? '价格与政策（英文）' : 'Pricing and policies'}
>
  {policyLinks.map((link) => (
    <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
      {link[locale]}
    </a>
  ))}
</nav>
<style>
  .policy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    padding-block: 20px;
    font-size: 13px;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
  }
  a:hover,
  a[aria-current] {
    color: var(--green-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 620px) {
    .policy-links {
      gap: 2px 22px;
    }
  }
</style>
