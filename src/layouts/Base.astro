---
import '../styles/global.css';
import '../styles/localization.css';
import {
  locales,
  localeKeys,
  localizedPath,
  type Locale,
  type TranslatedPage,
} from '../data/locales';
interface Props {
  title: string;
  description: string;
  locale: Locale;
  noindex?: boolean;
  canonicalPath?: string;
  translatedPage?: TranslatedPage | false;
}
const {
  title,
  description,
  locale,
  noindex = false,
  canonicalPath,
  translatedPage = 'home',
} = Astro.props;
const canonical = new URL(canonicalPath ?? localizedPath(locale), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8faf7" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {translatedPage && (
          <>
            {localeKeys.map((key) => (
              <link
                rel="alternate"
                hreflang={key}
                href={new URL(localizedPath(key, translatedPage), Astro.site)}
              />
            ))}
            <link
              rel="alternate"
              hreflang="x-default"
              href={new URL(localizedPath('en', translatedPage), Astro.site)}
            />
          </>
        )}
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PaperEnjoyer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[locale].og} />
    <meta property="og:image" content="https://paperenjoyer.com/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
